# ---------------------------------------------------------------
# Server (server/index.js reads these). Copy to .env — nothing here
# is required to run: the app boots on an empty SQLite database.
# ---------------------------------------------------------------

PORT=8787
# Where the SQLite file lives. Delete it to reseed.
DB_FILE=data/ecoconnect.db
# Set this in production; without it a dev secret is written to data/.jwt-secret
JWT_SECRET=

# --- vision (server-side only: this key never reaches a browser) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# Model IDs change — gemini-2.0-flash has been shut down.
# Default is gemini-3.7-flash. See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Optional explicit provider: gemini or openai. Gemini is preferred when both keys exist.
VISION_PROVIDER=gemini

# --- reverse geocoding ---
# Nominatim requires a real contact in the User-Agent. Put yours here.
GEOCODE_USER_AGENT=EcoConnectAI/0.1 (you@example.com)
# Swap in a paid geocoder if you outgrow Nominatim's 1 req/sec policy.
GEOCODE_ENDPOINT=

# --- batching ---
# Cron for the batching pass. "off" disables it (the manual button still works).
BATCH_CRON=*/2 * * * *

# --- front end (build-time, Vite) ---
# Only needed if the API is on another origin.
VITE_API_URL=
# Google Maps JavaScript API key for the map widgets.
VITE_GOOGLE_MAPS_API_KEY=
# Legacy map tiles are no longer used; leave blank unless you want to keep the old provider config.
VITE_TILE_URL=
